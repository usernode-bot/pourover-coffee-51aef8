{
  "name": "Pourover Coffee",
  "icon": {
    "emoji": "\u2615"
  },
  "secrets": [],
  "tests": [
    {
      "name": "Recipe library renders",
      "path": "/",
      "expectSelector": "#recipe-list [data-recipe-id]"
    },
    {
      "name": "Method page compares its recipes",
      "path": "/?method=v60",
      "expectText": "3 recipes for V60"
    },
    {
      "name": "Structured filters narrow the recipe library",
      "path": "/?filterMethod=v60&roast=light&profile=sweet",
      "expectText": "Sweet pulse"
    },
    {
      "name": "Recipe detail includes attribution and scaling",
      "path": "/?recipe=v60-bright",
      "expectText": "Pourover Coffee original"
    },
    {
      "id": "recipe.timeline",
      "name": "Recipe steps show elapsed-from-start timing",
      "path": "/?recipe=clever-water-first&shot=timeline",
      "expectText": "Start at 0:00",
      "expectSelector": ".recipe-step-timing",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "dapp.json"
      ]
    },
    {
      "id": "brew.guided-timer",
      "name": "Guided timer renders an active brew",
      "path": "/?brew=v60-bright&shot=active",
      "expectText": "Now",
      "expectSelector": "body.brew-focus #timer-panel[data-focus=\"active\"]",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "dapp.json"
      ]
    },
    {
      "id": "brew.cue-settings",
      "name": "Brew cue settings render with safe defaults",
      "path": "/?brew=v60-bright&shot=cues",
      "expectText": "Brew cues",
      "expectSelector": "#cue-settings:not([hidden])",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "dapp.json"
      ]
    },
    {
      "id": "brew.large-timer",
      "name": "Large-timer mode shows a high-contrast active brew",
      "path": "/?brew=v60-bright&shot=large",
      "expectText": "Now",
      "expectSelector": "body.brew-large #timer-panel[data-focus=\"active\"]",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "dapp.json"
      ]
    },
    {
      "id": "journal.history",
      "name": "Brew journal renders private history",
      "path": "/?journal=demo",
      "expectText": "Staging demo: Finca El Jard\u00edn",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "journal-store.js",
        "dapp.json"
      ]
    },
    {
      "id": "journal.snapshot",
      "name": "Journal entry preserves an exact recipe snapshot",
      "path": "/?journal=demo&entry=demo-v60",
      "expectText": "Brew snapshot",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "journal-store.js",
        "dapp.json"
      ]
    },
    {
      "id": "journal.adjustment",
      "name": "A journaled cup gets one guided next experiment",
      "path": "/?journal=demo&entry=demo-v60&adjust=sour",
      "expectText": "Try one small grind step finer",
      "expectSelector": "#journal-adjustment-result:not([hidden])",
      "visual": true,
      "impact": [
        "public/adjustments.js",
        "public/app.js",
        "public/index.html",
        "public/app.css",
        "dapp.json"
      ]
    },
    {
      "id": "journal.form",
      "name": "Manual brew journal form renders",
      "path": "/?journal=new",
      "expectText": "What did you use?",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "journal-store.js",
        "dapp.json"
      ]
    },
    {
      "name": "Library filters to favorites",
      "path": "/?favorites=1&demo=1",
      "expectText": "Favorites",
      "expectSelector": "#recipe-list .brew-recipe-card[data-recipe-id=\"v60-sweet-pulse\"]"
    },
    {
      "id": "shelf.favorites",
      "name": "Favorites shelf lists saved recipes",
      "path": "/?shelf=favorites&demo=1",
      "visual": true,
      "impact": [
        "public/**",
        "collection-store.js",
        "server.js",
        "dapp.json"
      ],
      "expectSelector": "#shelf-recipe-list .brew-recipe-card[data-recipe-id=\"switch-hybrid\"]"
    },
    {
      "name": "Recently brewed shelf shows past brews",
      "path": "/?shelf=brewed&demo=1",
      "expectSelector": "#shelf-recipe-list .brew-recipe-card[data-recipe-id]"
    },
    {
      "id": "shelf.collections",
      "name": "Collections view lists personal collections",
      "path": "/?shelf=collections&demo=1",
      "visual": true,
      "impact": [
        "public/**",
        "collection-store.js",
        "server.js",
        "dapp.json"
      ],
      "expectSelector": "#collection-list .collection-row"
    },
    {
      "id": "collection.detail",
      "name": "A collection keeps its recipe order",
      "path": "/?collection=demo-weekday&demo=1",
      "expectText": "Bright two-pour",
      "visual": true,
      "impact": [
        "public/**",
        "collection-store.js",
        "server.js",
        "dapp.json"
      ],
      "expectSelector": "#collection-recipe-list .collection-recipe-row[data-recipe-id]"
    },
    {
      "name": "Collection picker opens from a recipe",
      "path": "/?recipe=v60-bright&shot=picker&demo=1",
      "expectSelector": "#collection-picker:not([hidden])"
    },
    {
      "name": "Glossary browses every term",
      "path": "/?glossary=1",
      "expectSelector": "#glossary-list [data-term]"
    },
    {
      "name": "Glossary search narrows the list",
      "path": "/?glossary=1&q=drawdown",
      "expectText": "Drawdown"
    },
    {
      "id": "glossary.term-panel",
      "name": "A term opens a definition panel",
      "path": "/?glossary=1&term=bloom",
      "expectText": "wets the coffee and lets gas escape",
      "visual": true,
      "impact": [
        "public/glossary.js",
        "public/app.js",
        "public/index.html",
        "public/app.css",
        "dapp.json"
      ]
    },
    {
      "name": "AeroPress method compares three recipes",
      "path": "/?method=aeropress",
      "expectText": "3 recipes for AeroPress",
      "expectSelector": "#method-recipe-list [data-recipe-id=\"aeropress-standard\"]"
    },
    {
      "id": "manual.aeropress-recipe",
      "name": "AeroPress recipe shows action-aware steps",
      "path": "/?recipe=aeropress-inverted",
      "expectText": "Inverted sweet cup",
      "expectSelector": "#recipe-steps .recipe-step-action",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "dapp.json"
      ]
    },
    {
      "id": "manual.aeropress-timer",
      "name": "AeroPress timer handles an action without a water target",
      "path": "/?brew=aeropress-inverted&shot=active",
      "expectText": "Now \u00b7 Stir",
      "expectSelector": "#timer-panel[data-focus=\"active\"]",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "dapp.json"
      ]
    },
    {
      "id": "personal-recipes.library",
      "name": "Private recipe book shows active personal recipes",
      "path": "/?myRecipes=1&demo=1",
      "expectText": "Weekday honey V60",
      "expectSelector": "#personal-recipes-list .personal-recipe-card[data-recipe-id]",
      "visual": true,
      "impact": [
        "personal-recipe-store.js",
        "public/**",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "id": "personal-recipes.lineage",
      "name": "A personal variant retains its source recipe",
      "path": "/?recipe=personal-00000000-0000-4000-8000-000000000013&demo=1",
      "expectText": "Based on Sweet pulse v1",
      "expectSelector": "#personal-recipe-actions:not([hidden])",
      "visual": true,
      "impact": [
        "personal-recipe-store.js",
        "public/**",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "id": "personal-recipes.editor",
      "name": "A brewer can make a private recipe variant",
      "path": "/?recipeEditor=new&source=v60-bright&demo=1",
      "expectText": "Make it your own",
      "expectSelector": "#personal-recipe-steps .personal-recipe-step-editor",
      "visual": true,
      "impact": [
        "personal-recipe-store.js",
        "public/**",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "id": "personal-recipes.timer",
      "name": "A personal recipe works in the guided timer",
      "path": "/?brew=personal-00000000-0000-4000-8000-000000000013&shot=active&demo=1",
      "expectText": "Now",
      "expectSelector": "#timer-panel[data-focus=\"active\"]",
      "visual": true,
      "impact": [
        "personal-recipe-store.js",
        "public/**",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "id": "offline.sync-status",
      "name": "Offline sync status reports queued writes",
      "path": "/?offline=shot",
      "expectText": "Sync status",
      "visual": true,
      "impact": [
        "public/**",
        "dapp.json"
      ]
    }
  ],
  "visibility": {
    "build": "private",
    "view": "public"
  }
}
