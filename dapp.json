{
  "name": "Pourover Coffee",
  "icon": {
    "emoji": "\u2615"
  },
  "secrets": [],
  "tests": [
    {
      "name": "Recipe library renders",
      "path": "/",
      "expectSelector": "#recipe-list [data-recipe-id]"
    },
    {
      "name": "Method page compares its recipes",
      "path": "/?method=v60",
      "expectText": "3 recipes for V60"
    },
    {
      "name": "Structured filters narrow the recipe library",
      "path": "/?filterMethod=v60&roast=light&profile=sweet",
      "expectText": "Sweet pulse"
    },
    {
      "name": "Recipe detail includes attribution and scaling",
      "path": "/?recipe=v60-bright",
      "expectText": "Pourover Coffee original"
    },
    {
      "id": "brew.guided-timer",
      "name": "Guided timer renders an active brew",
      "path": "/?brew=v60-bright&shot=active",
      "expectText": "Get ready",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "dapp.json"
      ]
    },
    {
      "id": "journal.history",
      "name": "Brew journal renders private history",
      "path": "/?journal=demo",
      "expectText": "Staging demo: Finca El Jard\u00edn",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "journal-store.js",
        "dapp.json"
      ]
    },
    {
      "id": "journal.snapshot",
      "name": "Journal entry preserves an exact recipe snapshot",
      "path": "/?journal=demo&entry=demo-v60",
      "expectText": "Brew snapshot",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "journal-store.js",
        "dapp.json"
      ]
    },
    {
      "id": "journal.form",
      "name": "Manual brew journal form renders",
      "path": "/?journal=new",
      "expectText": "What did you use?",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "journal-store.js",
        "dapp.json"
      ]
    },
    {
      "name": "Glossary browses every term",
      "path": "/?glossary=1",
      "expectSelector": "#glossary-list [data-term]"
    },
    {
      "name": "Glossary search narrows the list",
      "path": "/?glossary=1&q=drawdown",
      "expectText": "Drawdown"
    },
    {
      "name": "Library filters to favorites",
      "path": "/?scope=favorites",
      "expectSelector": "#filter-favorites[aria-pressed=\"true\"]"
    },
    {
      "name": "Library filters to recently brewed recipes",
      "path": "/?scope=recent",
      "expectSelector": "#filter-recent[aria-pressed=\"true\"]"
    },
    {
      "name": "A recipe shows its favorite and collection controls",
      "path": "/?recipe=v60-bright",
      "expectSelector": "#recipe-favorite[aria-pressed]"
    },
    {
      "id": "shelf.favorites",
      "name": "Shelf shows favorites and recently brewed recipes",
      "path": "/?shelf=demo",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "server.js",
        "shelf-store.js",
        "dapp.json"
      ],
      "expectSelector": "#favorites-list [data-recipe-id]"
    },
    {
      "id": "shelf.collections",
      "name": "Shelf manages personal collections",
      "path": "/?shelf=demo&tab=collections",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "server.js",
        "shelf-store.js",
        "dapp.json"
      ],
      "expectSelector": "#collection-list [data-collection-card]"
    },
    {
      "id": "shelf.collection-detail",
      "name": "A collection preserves its recipe order",
      "path": "/?collection=900001&shelf=demo",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "server.js",
        "shelf-store.js",
        "dapp.json"
      ],
      "expectSelector": "#collection-items [data-recipe-id]"
    },
    {
      "id": "shelf.picker",
      "name": "A recipe can join one or more collections",
      "path": "/?recipe=v60-bright&picker=1",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "server.js",
        "shelf-store.js",
        "dapp.json"
      ],
      "expectSelector": "#recipe-collection-toggle[aria-expanded=\"true\"]"
    },
    {
      "id": "glossary.term-panel",
      "name": "A term opens a definition panel",
      "path": "/?glossary=1&term=bloom",
      "expectText": "wets the coffee and lets gas escape",
      "visual": true,
      "impact": [
        "public/glossary.js",
        "public/app.js",
        "public/index.html",
        "public/app.css",
        "dapp.json"
      ]
    }
  ],
  "visibility": {
    "build": "private",
    "view": "public"
  }
}
