{
  "name": "Pourover Coffee",
  "icon": {
    "emoji": "☕"
  },
  "secrets": [],
  "tests": [
    {
      "name": "Recipe library renders",
      "path": "/",
      "expectSelector": "#recipe-list [data-recipe-id]"
    },
    {
      "name": "Method page compares its recipes",
      "path": "/?method=v60",
      "expectText": "3 recipes for V60"
    },
    {
      "name": "Structured filters narrow the recipe library",
      "path": "/?filterMethod=v60&roast=light&profile=sweet",
      "expectText": "Sweet pulse"
    },
    {
      "name": "Recipe detail includes attribution and scaling",
      "path": "/?recipe=v60-bright",
      "expectText": "Pourover Coffee original"
    },
    {
      "id": "brew.guided-timer",
      "name": "Guided timer renders an active brew",
      "path": "/?brew=v60-bright&shot=active",
      "expectText": "Get ready",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "dapp.json"
      ]
    },
    {
      "id": "journal.history",
      "name": "Brew journal renders private history",
      "path": "/?journal=demo",
      "expectText": "Staging demo: Finca El Jardín",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "journal-store.js",
        "dapp.json"
      ]
    },
    {
      "id": "journal.snapshot",
      "name": "Journal entry preserves an exact recipe snapshot",
      "path": "/?journal=demo&entry=demo-v60",
      "expectText": "Brew snapshot",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "journal-store.js",
        "dapp.json"
      ]
    },
    {
      "id": "journal.form",
      "name": "Manual brew journal form renders",
      "path": "/?journal=new",
      "expectText": "What did you use?",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "journal-store.js",
        "dapp.json"
      ]
    },
    {
      "name": "Library filters to favorites",
      "path": "/?favorites=1&demo=1",
      "expectText": "Favorites",
      "expectSelector": "#recipe-list .brew-recipe-card[data-recipe-id=\"v60-sweet-pulse\"]"
    },
    {
      "id": "shelf.favorites",
      "name": "Favorites shelf lists saved recipes",
      "path": "/?shelf=favorites&demo=1",
      "visual": true,
      "impact": [
        "public/**",
        "collection-store.js",
        "server.js",
        "dapp.json"
      ],
      "expectSelector": "#shelf-recipe-list .brew-recipe-card[data-recipe-id=\"switch-hybrid\"]"
    },
    {
      "name": "Recently brewed shelf shows past brews",
      "path": "/?shelf=brewed&demo=1",
      "expectSelector": "#shelf-recipe-list .brew-recipe-card[data-recipe-id]"
    },
    {
      "id": "shelf.collections",
      "name": "Collections view lists personal collections",
      "path": "/?shelf=collections&demo=1",
      "visual": true,
      "impact": [
        "public/**",
        "collection-store.js",
        "server.js",
        "dapp.json"
      ],
      "expectSelector": "#collection-list .collection-row"
    },
    {
      "id": "collection.detail",
      "name": "A collection keeps its recipe order",
      "path": "/?collection=demo-weekday&demo=1",
      "expectText": "Bright two-pour",
      "visual": true,
      "impact": [
        "public/**",
        "collection-store.js",
        "server.js",
        "dapp.json"
      ],
      "expectSelector": "#collection-recipe-list .collection-recipe-row[data-recipe-id]"
    },
    {
      "name": "Collection picker opens from a recipe",
      "path": "/?recipe=v60-bright&shot=picker&demo=1",
      "expectSelector": "#collection-picker:not([hidden])"
    },
    {
      "name": "Glossary browses every term",
      "path": "/?glossary=1",
      "expectSelector": "#glossary-list [data-term]"
    },
    {
      "name": "Glossary search narrows the list",
      "path": "/?glossary=1&q=drawdown",
      "expectText": "Drawdown"
    },
    {
      "id": "glossary.term-panel",
      "name": "A term opens a definition panel",
      "path": "/?glossary=1&term=bloom",
      "expectText": "wets the coffee and lets gas escape",
      "visual": true,
      "impact": [
        "public/glossary.js",
        "public/app.js",
        "public/index.html",
        "public/app.css",
        "dapp.json"
      ]
    }
  ],
  "visibility": {
    "build": "private",
    "view": "public"
  }
}
